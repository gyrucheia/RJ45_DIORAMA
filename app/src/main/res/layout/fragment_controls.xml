<?xml version="1.0" encoding="utf-8"?>
<!--
  Controls — optional manual overrides, separate from Simulation.
  Six expandable cards. Each card shows a status chip driven by MASTER
  acknowledgments (Offline / Ready / Requested / Accepted / Running / Completed / Failed).
  Visual theme intentionally matches the rest of SanLoMobApp.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/card_bg">

    <!-- ===== PINNED TOP APP BAR ===== -->
    <LinearLayout
        android:id="@+id/layout_controls_pinned_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingEnd="@dimen/screen_horizontal_margin"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:background="@color/card_bg">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/rj45_logo"
            android:scaleType="fitCenter"
            android:layout_marginEnd="12dp"
            android:contentDescription="RJ45 Logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RJ45 DIORAMA"
                android:textColor="@color/sap_green"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:fontFamily="@font/inter_regular"
                android:textStyle="bold"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/tv_controls_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Manual Controls"
                android:textColor="@color/text_dark"
                android:textSize="@dimen/title_text_size"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_regular" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Optional. The diorama checks every request for safety."
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:fontFamily="@font/inter_regular" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_controls_online"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_chip_coral"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Offline"
            android:textColor="@color/alert_red"
            android:textSize="11sp"
            android:fontFamily="@font/inter_regular" />
    </LinearLayout>

    <!-- Hairline Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#12000000" />

    <!-- ===== SCROLLABLE CONTENT BODY ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/card_bg"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal_margin"
            android:paddingEnd="@dimen/screen_horizontal_margin"
            android:paddingTop="14dp"
            android:paddingBottom="40dp">

            <!-- Offline notice -->
            <TextView
                android:id="@+id/tv_controls_offline_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gesture_dir_pill"
                android:padding="12dp"
                android:text="Controls are paused while the diorama is offline."
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:fontFamily="@font/inter_regular" />

        <!-- ================= 1. TRAM ================= -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_white">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/header_tram"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:background="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icon_circle_orange">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_tram"
                            app:tint="@color/white"
                            android:contentDescription="Tram" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tram"
                            android:textColor="@color/text_dark"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_regular" />
                        <TextView
                            android:id="@+id/tv_summary_tram"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter_regular" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/chip_tram"
                        style="@style/ControlStatusChip" />

                    <TextView
                        android:id="@+id/chevron_tram"
                        style="@style/ControlChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/body_tram"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="14dp"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btn_tram_reverse"
                        style="@style/ControlActionButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Reverse" />
                    <Button
                        android:id="@+id/btn_tram_stop"
                        style="@style/ControlActionButton.Secondary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="Stop" />
                    <Button
                        android:id="@+id/btn_tram_forward"
                        style="@style/ControlActionButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Forward" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ================= 2. STREET LIGHTS ================= -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/header_lights"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:background="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icon_circle_amber">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_onboard_sun"
                            app:tint="@color/white"
                            android:contentDescription="Street lights" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Street Lights"
                            android:textColor="@color/text_dark"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_regular" />
                        <TextView
                            android:id="@+id/tv_summary_lights"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter_regular" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/chip_lights"
                        style="@style/ControlStatusChip" />

                    <TextView
                        android:id="@+id/chevron_lights"
                        style="@style/ControlChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/body_lights"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="14dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Show the diorama at a different time of day"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_regular" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <Button
                            android:id="@+id/btn_time_day"
                            style="@style/ControlActionButton.Secondary"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Day" />
                        <Button
                            android:id="@+id/btn_time_evening"
                            style="@style/ControlActionButton.Secondary"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:text="Evening" />
                        <Button
                            android:id="@+id/btn_time_night"
                            style="@style/ControlActionButton.Secondary"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Night" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_time_real"
                        style="@style/ControlActionButton"
                        android:layout_width="match_parent"
                        android:layout_marginTop="8dp"
                        android:text="Use real clock" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ================= 3. RIVER LIGHTS (RGB) ================= -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/header_rgb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:background="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icon_circle_lights">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_rgb_light"
                            app:tint="@color/white"
                            android:contentDescription="River lights" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="River Lights"
                            android:textColor="@color/text_dark"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_regular" />
                        <TextView
                            android:id="@+id/tv_summary_rgb"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter_regular" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/chip_rgb"
                        style="@style/ControlStatusChip" />

                    <TextView
                        android:id="@+id/chevron_rgb"
                        style="@style/ControlChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/body_rgb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="14dp"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btn_rgb_sensor"
                        style="@style/ControlActionButton"
                        android:layout_width="match_parent"
                        android:text="Follow the color sensor" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Or choose a color"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_regular" />

                    <LinearLayout
                        android:id="@+id/row_rgb_swatches"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ================= 4. WIND ================= -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/header_wind"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:background="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icon_circle_teal">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_fog"
                            app:tint="@color/white"
                            android:contentDescription="Wind" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wind"
                            android:textColor="@color/text_dark"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_regular" />
                        <TextView
                            android:id="@+id/tv_summary_wind"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter_regular" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/chip_wind"
                        style="@style/ControlStatusChip" />

                    <TextView
                        android:id="@+id/chevron_wind"
                        style="@style/ControlChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/body_wind"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="14dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="The fan makes a breeze that bends the wind sensor."
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_regular" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <Button
                            android:id="@+id/btn_fan_on"
                            style="@style/ControlActionButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="Fan on" />
                        <Button
                            android:id="@+id/btn_fan_off"
                            style="@style/ControlActionButton.Secondary"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Fan off" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ================= 5. DRAINAGE ================= -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/header_drainage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:background="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icon_circle_coral">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_pump"
                            app:tint="@color/white"
                            android:contentDescription="Drainage" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Drainage"
                            android:textColor="@color/text_dark"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_regular" />
                        <TextView
                            android:id="@+id/tv_summary_drainage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter_regular" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/chip_drainage"
                        style="@style/ControlStatusChip" />

                    <TextView
                        android:id="@+id/chevron_drainage"
                        style="@style/ControlChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/body_drainage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="14dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <Button
                            android:id="@+id/btn_pump_on"
                            style="@style/ControlActionButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="Pump on" />
                        <Button
                            android:id="@+id/btn_pump_off"
                            style="@style/ControlActionButton.Secondary"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Pump off" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_gesture_dir_pill"
                        android:padding="10dp"
                        android:text="Safety Interlock: Verify water level before manual activation to prevent pump dry-run damage. The flood warning signal (SG90 45°) is controlled automatically by the MASTER safety supervisor."
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter_regular" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ================= 6. AUDIO ================= -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/header_audio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:background="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icon_circle_salmon">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_audio"
                            app:tint="@color/white"
                            android:contentDescription="Narration" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Narration"
                            android:textColor="@color/text_dark"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_regular" />
                        <TextView
                            android:id="@+id/tv_summary_audio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter_regular" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/chip_audio"
                        style="@style/ControlStatusChip" />

                    <TextView
                        android:id="@+id/chevron_audio"
                        style="@style/ControlChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/body_audio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="14dp"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btn_play_narration"
                        style="@style/ControlActionButton"
                        android:layout_width="match_parent"
                        android:text="Play diorama narration" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ================= STOP EVERYTHING ================= -->
        <Button
            android:id="@+id/btn_emergency_stop"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/action_button_height"

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Timestamp (left) -->
    <TextView
        android:id="@+id/tv_log_timestamp"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:text="11:17 PM"
        android:textColor="@color/text_muted"
        android:textSize="10sp"
        android:fontFamily="@font/inter_regular"
        android:layout_marginEnd="10dp" />

    <!-- Vertical connector line + icon -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginEnd="12dp">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_circle_orange">

            <ImageView
                android:id="@+id/iv_log_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_tram"
                android:tint="@color/white"
                android:contentDescription="Event icon" />
        </FrameLayout>
    </LinearLayout>

    <!-- Title + subtitle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_log_event_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tram started"
            android:textColor="@color/text_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter_regular" />

        <TextView
            android:id="@+id/tv_log_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Gesture · RIGHT"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:fontFamily="@font/inter_regular" />
    </LinearLayout>

    <!-- NEW badge (shown only for recent/new items) -->
    <TextView
        android:id="@+id/tv_log_new_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_explore_card_teal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text="NEW"
        android:textColor="#00796B"
        android:textSize="9sp"
        android:textStyle="bold"
        android:fontFamily="@font/inter_regular"
        android:visibility="gone" />

</LinearLayout>

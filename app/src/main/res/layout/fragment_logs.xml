<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/card_bg">

    <!-- ===== PINNED TOP APP BAR ===== -->
    <LinearLayout
        android:id="@+id/layout_logs_pinned_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card_bg"
        android:paddingTop="16dp"
        android:paddingBottom="10dp">

        <!-- Title Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/screen_horizontal_margin"
            android:paddingEnd="@dimen/screen_horizontal_margin">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RJ45 DIORAMA"
                    android:textColor="@color/sap_green"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:fontFamily="@font/inter_regular"
                    android:textStyle="bold"
                    android:textAllCaps="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Activity"
                    android:textColor="@color/text_dark"
                    android:textSize="@dimen/title_text_size"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_regular" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See what happened around the diorama."
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter_regular" />
            </LinearLayout>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/rj45_logo"
                android:scaleType="fitCenter"
                android:contentDescription="RJ45 Logo" />
        </LinearLayout>

        <!-- ===== FILTER CHIPS ROW (Pinned like Facebook Tabs) ===== -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="@dimen/screen_horizontal_margin"
            android:paddingEnd="@dimen/screen_horizontal_margin"
            android:scrollbars="none"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Hamburger -->
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_nav_activity"
                    android:tint="@color/text_muted"
                    android:contentDescription="Filter"
                    android:layout_marginEnd="8dp" />

                <!-- All chip (active) -->
                <TextView
                    android:id="@+id/chip_all"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_tram_status_card"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center"
                    android:text="All"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_regular" />

                <!-- Simulation chip -->
                <TextView
                    android:id="@+id/chip_simulation"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_tram_return_btn"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center"
                    android:text="Simulation"
                    android:textColor="@color/text_dark"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_regular" />

                <!-- Tram chip -->
                <TextView
                    android:id="@+id/chip_tram"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_tram_return_btn"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center"
                    android:text="Tram"
                    android:textColor="@color/text_dark"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_regular" />

                <!-- Environment chip -->
                <TextView
                    android:id="@+id/chip_environment"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_tram_return_btn"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center"
                    android:text="Environment"
                    android:textColor="@color/text_dark"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_regular" />

                <!-- System chip -->
                <TextView
                    android:id="@+id/chip_system"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_tram_return_btn"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center"
                    android:text="System"
                    android:textColor="@color/text_dark"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_regular" />

                <!-- Errors chip -->
                <TextView
                    android:id="@+id/chip_errors"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_tram_return_btn"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center"
                    android:text="Errors"
                    android:textColor="@color/text_dark"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_regular" />

            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Hairline Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#12000000" />

    <!-- ===== BODY AREA ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- ===== ACTIVITY LOG CARD ===== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/screen_horizontal_margin"
            android:layout_marginEnd="@dimen/screen_horizontal_margin"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- TODAY section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TODAY"
                        android:textColor="@color/text_dark"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:fontFamily="@font/inter_regular" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 events"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter_regular" />
                </LinearLayout>

                <!-- RecyclerView fills remaining space -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_logs"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="16dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ===== SYNC BANNER ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_horizontal_margin"
            android:layout_marginEnd="@dimen/screen_horizontal_margin"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_sync_banner"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_sensor_humidity"
                android:tint="@color/sap_green"
                android:contentDescription="Sync"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activity syncs live while your diorama is connected."
                android:textColor="@color/sap_green"
                android:textSize="12sp"
                android:fontFamily="@font/inter_regular" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>


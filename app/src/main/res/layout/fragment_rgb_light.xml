<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/card_bg">

        <!-- ===== PINNED TOP APP BAR ===== -->
        <LinearLayout
            android:id="@+id/layout_rgb_pinned_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/screen_horizontal_margin"
            android:paddingEnd="@dimen/screen_horizontal_margin"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            android:background="@color/card_bg">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/rj45_logo"
                android:scaleType="fitCenter"
                android:layout_marginEnd="12dp"
                android:contentDescription="RJ45 Logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RJ45 DIORAMA"
                    android:textColor="@color/sap_green"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:fontFamily="@font/inter_regular"
                    android:textStyle="bold"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/tv_rgb_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="River Light Studio"
                    android:textColor="@color/text_dark"
                    android:textSize="@dimen/title_text_size"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_regular" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Change the mood of your miniature world."
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter_regular" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_chip_green"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="Studio"
                android:textColor="@color/sap_green"
                android:textSize="11sp"
                android:fontFamily="@font/inter_regular" />
        </LinearLayout>

        <!-- Hairline Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#12000000" />

        <!-- ===== SCROLLABLE CONTENT BODY ===== -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/card_bg"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:paddingBottom="120dp">

                <!-- ===== HERO CARD (landscape preview) ===== -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_rgb_hero"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginStart="@dimen/screen_horizontal_margin"
                    android:layout_marginEnd="@dimen/screen_horizontal_margin"
                    android:layout_marginTop="4dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#C8DFC8">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_onboard_landscape"
                        android:scaleType="centerCrop"
                        android:contentDescription="Diorama preview" />

                    <!-- Status chip at bottom -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="12dp">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:id="@+id/tv_brightness_pct_hero"
                            android:text="72%"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_regular" />
                    </LinearLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== CHOOSE A COLOR CARD ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CHOOSE A COLOR"
                                android:textColor="@color/text_muted"
                                android:textSize="10sp"
                                android:letterSpacing="0.08"
                                android:fontFamily="@font/inter_regular" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Set the river glow"
                                android:textColor="@color/text_dark"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/poppins_regular" />
                        </LinearLayout>

                        <!-- Color swatch preview chip -->
                        <View
                            android:id="@+id/view_color_swatch"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_color_circle" />
                    </LinearLayout>

                    <!-- Large circle + HEX/RGB info row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="14dp">

                        <!-- Big color circle -->
                        <View
                            android:id="@+id/view_color_swatch_large"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:background="@drawable/bg_color_circle"
                            android:layout_marginEnd="16dp" />

                        <!-- HEX + RGB labels -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="@drawable/bg_gesture_dir_pill"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:layout_marginBottom="6dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="HEX"
                                    android:textColor="@color/text_muted"
                                    android:textSize="11sp"
                                    android:fontFamily="@font/inter_regular" />

                                <TextView
                                    android:id="@+id/tv_color_hex"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="#47AFC3"
                                    android:textColor="@color/text_dark"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/roboto_mono_regular" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="@drawable/bg_gesture_dir_pill"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="RGB"
                                    android:textColor="@color/text_muted"
                                    android:textSize="11sp"
                                    android:fontFamily="@font/inter_regular" />

                                <TextView
                                    android:id="@+id/tv_rgb_values"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="71, 175, 195"
                                    android:textColor="@color/text_dark"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/roboto_mono_regular" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Brightness row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="16dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_onboard_sun"
                            android:tint="@color/text_muted"
                            android:contentDescription="Brightness"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Brightness"
                            android:textColor="@color/text_dark"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/inter_regular" />

                        <TextView
                            android:id="@+id/tv_brightness_pct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="72%"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter_regular" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekbar_brightness"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:progress="72"
                        android:max="100"
                        android:progressTint="@color/sap_green"
                        android:thumbTint="@color/sap_green" />

                    <!-- MOOD PRESETS label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="10dp"
                        android:text="MOOD PRESETS"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:letterSpacing="0.08"
                        android:fontFamily="@font/inter_regular" />

                    <!-- Mood preset circles row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Daylight -->
                        <LinearLayout
                            android:id="@+id/btn_preset_warm"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">
                            <View
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:background="@drawable/bg_color_circle" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Daylight"
                                android:textColor="@color/text_muted"
                                android:textSize="9sp"
                                android:fontFamily="@font/inter_regular" />
                        </LinearLayout>

                        <!-- Sunset -->
                        <LinearLayout
                            android:id="@+id/btn_preset_sunset"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">
                            <View
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:background="@drawable/bg_icon_circle_orange" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Sunset"
                                android:textColor="@color/text_muted"
                                android:textSize="9sp"
                                android:fontFamily="@font/inter_regular" />
                        </LinearLayout>

                        <!-- River (teal, active) -->
                        <LinearLayout
                            android:id="@+id/btn_preset_cool"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">
                            <View
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:background="@drawable/bg_icon_circle_explore" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="River"
                                android:textColor="@color/sap_green"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/inter_regular" />
                        </LinearLayout>

                        <!-- Forest -->
                        <LinearLayout
                            android:id="@+id/btn_preset_nature"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">
                            <View
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:background="@drawable/bg_explore_card_green" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Forest"
                                android:textColor="@color/text_muted"
                                android:textSize="9sp"
                                android:fontFamily="@font/inter_regular" />
                        </LinearLayout>

                        <!-- Night -->
                        <LinearLayout
                            android:id="@+id/btn_preset_alert"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">
                            <View
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:background="@drawable/bg_icon_circle_coral" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Night"
                                android:textColor="@color/text_muted"
                                android:textSize="9sp"
                                android:fontFamily="@font/inter_regular" />
                        </LinearLayout>

                        <!-- Alert -->
                        <LinearLayout
                            android:id="@+id/btn_preset_off"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">
                            <View
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:background="@drawable/bg_icon_circle_salmon" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Alert"
                                android:textColor="@color/text_muted"
                                android:textSize="9sp"
                                android:fontFamily="@font/inter_regular" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== COLOR SENSOR CARD ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#E0F4F4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icon_circle_teal">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_sensor_water"
                                android:tint="#00796B"
                                android:contentDescription="Color Sensor" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="COLOR SENSOR"
                                android:textColor="#00796B"
                                android:textSize="10sp"
                                android:letterSpacing="0.08"
                                android:fontFamily="@font/inter_regular" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Match a Real Object"
                                android:textColor="@color/text_dark"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/poppins_regular" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Place a colored object near the diorama and let the river copy its color."
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"
                                android:fontFamily="@font/inter_regular" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Scan button -->
                    <Button
                        android:id="@+id/btn_color_match"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_tram_return_btn"
                        android:text="Scan Object Color"
                        android:textColor="@color/text_dark"
                        android:fontFamily="@font/poppins_regular"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:stateListAnimator="@null"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== APPLY TO DIORAMA BUTTON ===== -->
            <Button
                android:id="@+id/btn_apply_color"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tram_status_card"
                android:text="Apply to Diorama"
                android:textColor="@color/white"
                android:fontFamily="@font/poppins_regular"
                android:textSize="15sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp" />

        </LinearLayout>

    </ScrollView>
    </LinearLayout>

    <!-- ===== ASK SANLO FLOATING BUTTON ===== -->
    <LinearLayout
        android:id="@+id/btn_ask_sanlo_rgb"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_ask_sanlo_fab"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="18dp"
        android:elevation="8dp">

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_circle_white"
            android:layout_marginEnd="8dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/rj45_logo"
                android:scaleType="fitCenter"
                android:contentDescription="RJ45 Logo" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ask RJ45"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_regular" />
    </LinearLayout>

</FrameLayout>

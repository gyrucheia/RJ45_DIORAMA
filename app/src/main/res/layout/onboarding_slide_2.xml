<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EEF5EE"
    android:paddingTop="76dp">

    <!-- Illustration card -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_onboarding_card"
        android:clipToOutline="true">

        <!-- Landscape background -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_onboard_landscape"
            android:scaleType="centerCrop" />

        <!-- Center icon (white card with sliders) -->
        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:layout_marginBottom="40dp"
            android:background="@drawable/bg_onboarding_icon"
            android:gravity="center"
            android:elevation="4dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_onboard_sliders"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <!-- Tram badge overlay (bottom-left of icon) -->
        <LinearLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:layout_marginTop="60dp"
            android:layout_marginEnd="60dp"
            android:background="@drawable/bg_onboarding_tram_badge"
            android:gravity="center"
            android:elevation="6dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_tram"
                android:scaleType="fitCenter"
                android:tint="#1A3D1A" />
        </LinearLayout>

    </FrameLayout>

    <!-- Text content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="02 / 04"
            android:textColor="#C0392B"
            android:textSize="12sp"
            android:letterSpacing="0.05"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bring it to life"
            android:textColor="#1A3D1A"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Use Control to move the tram, start the river flow, add wind, play nature sounds, and change ambient lights."
            android:textColor="#4A7A50"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.4"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_onboarding_tip"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIP"
                android:textColor="#4A7A50"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unavailable actions are automatically disabled to keep the model safe."
                android:textColor="#4A7A50"
                android:textSize="12sp"
                android:fontFamily="sans-serif"
                android:layout_weight="1" />
        </LinearLayout>

    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="72dp" />

</LinearLayout>

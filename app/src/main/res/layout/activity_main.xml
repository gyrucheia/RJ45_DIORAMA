<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/card_bg"
    tools:context=".MainActivity">

    <!-- Fragment content area -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="88dp" />

    <!-- Floating bottom nav bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_nav_card"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="36dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/white"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp">

            <!-- Overview / Dashboard -->
            <LinearLayout
                android:id="@+id/nav_item_sensors"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <FrameLayout
                    android:id="@+id/nav_bg_sensors"
                    android:layout_width="48dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_nav_active_pill">
                    <ImageView
                        android:id="@+id/nav_icon_sensors"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_home"
                        android:contentDescription="Overview" />
                </FrameLayout>

                <TextView
                    android:id="@+id/nav_label_sensors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Overview"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="9sp"
                    android:textColor="@color/sap_green" />
            </LinearLayout>

            <!-- Simulation (Main Feature) -->
            <LinearLayout
                android:id="@+id/nav_item_simulation"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <FrameLayout
                    android:id="@+id/nav_bg_simulation"
                    android:layout_width="48dp"
                    android:layout_height="28dp">
                    <ImageView
                        android:id="@+id/nav_icon_simulation"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_simulation"
                        android:contentDescription="Simulation" />
                </FrameLayout>

                <TextView
                    android:id="@+id/nav_label_simulation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Simulation"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="9sp"
                    android:textColor="@color/nav_inactive" />
            </LinearLayout>

            <!-- Controls -->
            <LinearLayout
                android:id="@+id/nav_item_controls"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <FrameLayout
                    android:id="@+id/nav_bg_controls"
                    android:layout_width="48dp"
                    android:layout_height="28dp">
                    <ImageView
                        android:id="@+id/nav_icon_controls"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_control"
                        android:contentDescription="Controls" />
                </FrameLayout>

                <TextView
                    android:id="@+id/nav_label_controls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Controls"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="9sp"
                    android:textColor="@color/nav_inactive" />
            </LinearLayout>

            <!-- Explore AI -->
            <LinearLayout
                android:id="@+id/nav_item_explore"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <FrameLayout
                    android:id="@+id/nav_bg_explore"
                    android:layout_width="48dp"
                    android:layout_height="28dp">
                    <ImageView
                        android:id="@+id/nav_icon_explore"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_explore"
                        android:contentDescription="Explore" />
                </FrameLayout>

                <TextView
                    android:id="@+id/nav_label_explore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Explore"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="9sp"
                    android:textColor="@color/nav_inactive" />
            </LinearLayout>

            <!-- Logs / Activity -->
            <LinearLayout
                android:id="@+id/nav_item_logs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <FrameLayout
                    android:id="@+id/nav_bg_logs"
                    android:layout_width="48dp"
                    android:layout_height="28dp">
                    <ImageView
                        android:id="@+id/nav_icon_logs"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_activity"
                        android:contentDescription="Logs" />
                </FrameLayout>

                <TextView
                    android:id="@+id/nav_label_logs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Logs"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="9sp"
                    android:textColor="@color/nav_inactive" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ===== GLOBAL ASK SANLO FLOATING BUTTON ===== -->
    <LinearLayout
        android:id="@+id/btn_ask_sanlo_global"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="100dp"
        android:background="@drawable/bg_ask_sanlo_fab"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="18dp"
        android:elevation="10dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/rj45_logo"
            android:scaleType="fitCenter"
            android:layout_marginEnd="8dp"
            android:contentDescription="RJ45 Logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ask RJ45"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_regular" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
